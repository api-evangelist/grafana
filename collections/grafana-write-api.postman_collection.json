        {
          "id": "ad686a55-ba8d-4da2-8387-aa412b650da6",
          "name": "Grafana Create Recording Rule Write Target",
          "request": {
            "name": "Grafana Create Recording Rule Write Target",
            "description": {
              "content": "The POST operation on the /recording-rules/writer endpoint in Grafana allows administrators to create a new recording rule write target, which defines a destination where pre-computed metric aggregations (recording rules) should be written. This endpoint accepts configuration details such as the remote write URL, authentication credentials, and other parameters necessary to establish a connection with the target storage system. Recording rule write targets enable Grafana to send the results of recording rule evaluations to external time-series databases or other compatible endpoints, facilitating data distribution, backup strategies, or multi-tenancy scenarios where recording rule results need to be persisted or forwarded to different storage backends.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "recording-rules",
                "writer"
              ],
              "host": [
                "{{baseUrl}}"
              ],
