        {
          "id": "b114c805-da36-4d46-b499-62f836081835",
          "name": "Grafana Unstar Dashboard By UID",
          "request": {
            "name": "Grafana Unstar Dashboard By UID",
            "description": {
              "content": "This API operation removes a star from a specific Grafana dashboard for the currently authenticated user by using the dashboard's unique identifier (UID). When executed via an HTTP DELETE request to the endpoint /user/stars/dashboard/uid/{dashboard_uid}, it unmarks the specified dashboard as a favorite, effectively removing it from the user's starred dashboards collection. The operation requires the dashboard_uid parameter to be provided in the URL path to identify which dashboard should be unstarred, and authentication is necessary to determine which user's star list should be modified.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user",
                "stars",
                "dashboard",
                "uid",
                ":dashboard_uid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dashboard_uid",
                  "description": "(Required) "
                },
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
