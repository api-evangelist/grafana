        {
          "id": "41dd5ebf-e4bf-420c-a569-0a24056641bb",
          "name": "Grafana Get Correlations By Source UID",
          "request": {
            "name": "Grafana Get Correlations By Source UID",
            "description": {
              "content": "This API operation retrieves all correlations associated with a specific data source in Grafana by providing the data source's unique identifier (UID). It uses a GET request to the endpoint /datasources/uid/{sourceUID}/correlations, where {sourceUID} is replaced with the actual UID of the data source you want to query. The operation returns a list of correlation configurations that have been defined for the specified data source, which are used to link related data across different data sources in Grafana, enabling users to navigate between panels and dashboards based on contextual relationships in their observability data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasources",
                "uid",
                ":sourceUID",
                "correlations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sourceUID",
                  "description": "(Required) "
                },
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
