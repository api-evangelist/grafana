          "name": "Grafana Test Create Recording Rule",
          "request": {
            "name": "Grafana Test Create Recording Rule",
            "description": {
              "content": "This API operation allows users to test the creation of a recording rule in Grafana before actually implementing it. By sending a POST request to the /recording-rules/test endpoint, users can validate their recording rule configuration, including the PromQL expression, labels, and other parameters, to ensure it functions as expected without permanently adding it to the system. This testing capability helps prevent errors and allows users to verify that their recording rule will produce the desired metrics aggregation or computation results in their monitoring setup before committing the changes to their Grafana instance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "recording-rules",
                "test"
              ],
              "host": [
