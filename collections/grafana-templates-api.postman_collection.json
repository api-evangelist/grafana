        {
          "id": "2abf91ad-c03b-471f-88df-434b87158c62",
          "name": "Grafana Route Get Template",
          "request": {
            "name": "Grafana Route Get Template",
            "description": {
              "content": "The Get Template operation retrieves a specific notification template by its name from Grafana's provisioning API. This endpoint allows users to fetch the complete configuration details of a previously created template, including its content, title, and any associated metadata. By making a GET request to /v1/provisioning/templates/{name} where {name} is the unique identifier of the template, administrators can programmatically access template definitions that are used for formatting alert notifications across various contact points and integrations within Grafana's alerting system.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "provisioning",
                "templates",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) Template group name"
                },
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{instance}}",
