        {
          "id": "142afcbb-01c1-44d8-bd2b-dd536e709e31",
          "name": "Grafana Route Delete Template",
          "request": {
            "name": "Grafana Route Delete Template",
            "description": {
              "content": "This API operation deletes a specific notification template from Grafana's provisioning system by its name. When called with a DELETE request to the endpoint /v1/provisioning/templates/{name}, where {name} is the unique identifier of the template, it removes the specified template from the system's configuration. This is part of Grafana's provisioning API that allows programmatic management of notification templates, enabling administrators to automate the cleanup and removal of templates that are no longer needed in their alerting and notification workflows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "provisioning",
                "templates",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Version of template to use for optimistic concurrency. Leave empty to disable validation"
                }
              ],
              "variable": [
