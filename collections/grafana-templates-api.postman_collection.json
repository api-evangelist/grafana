          "id": "1f7b21c4-23b4-4584-ab96-5ee54597f3f1",
          "name": "Grafana Route Get Templates",
          "request": {
            "name": "Grafana Route Get Templates",
            "description": {
              "content": "This API operation retrieves provisioning templates from Grafana's alerting system. It is accessed via a GET request to the `/v1/provisioning/templates` endpoint and returns a collection of message templates that can be used for alert notifications. These templates define how alert messages are formatted and presented when notifications are sent through various channels, allowing administrators to standardize and customize the appearance and content of alert messages across their Grafana instance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "provisioning",
                "templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
