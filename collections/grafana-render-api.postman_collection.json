        {
          "id": "289e2ea8-b2a4-4729-8b34-d54b1040b5ee",
          "name": "Grafana Render Report PD Fs",
          "request": {
            "name": "Grafana Render Report PD Fs",
            "description": {
              "content": "This API operation retrieves rendered PDF versions of reports from Grafana. When invoked with a GET request to the /reports/render/pdfs endpoint, it allows users to access pre-generated or on-demand PDF renderings of Grafana reports, which typically contain dashboards, panels, and visualizations. The operation is useful for exporting report data in a portable, shareable format that can be distributed to stakeholders or archived for record-keeping purposes. Users would typically need appropriate authentication and permissions to access this endpoint, and may be able to specify parameters to control which reports are rendered or retrieved.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "render",
                "pdfs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dashboards",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "orientation",
                  "value": "<string>"
                },
                {
                  "disabled": false,
