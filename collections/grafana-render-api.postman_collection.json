          "id": "23737e13-2ea9-488e-aa6f-e6e5c0d93adf",
          "name": "Grafana Render Report CS Vs",
          "request": {
            "name": "Grafana Render Report CS Vs",
            "description": {
              "content": "This API operation retrieves rendered CSV versions of Grafana reports. When invoked with a GET request to the /reports/render/csvs endpoint, it processes and returns report data in CSV (Comma-Separated Values) format, making it suitable for exporting Grafana dashboard metrics and analytics into spreadsheet applications or for further data processing. This endpoint is particularly useful for users who need to access report information in a structured, tabular format outside of the Grafana interface, enabling integration with external tools, automated data pipelines, or offline analysis workflows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "render",
                "csvs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dashboards",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "title",
                  "value": "<string>"
                }
              ],
