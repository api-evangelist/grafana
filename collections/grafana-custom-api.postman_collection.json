          "name": "Grafana Get Custom Permissions Report",
          "request": {
            "name": "Grafana Get Custom Permissions Report",
            "description": {
              "content": "This API operation retrieves a custom permissions report from Grafana's licensing endpoint. When invoked via a GET request to the /licensing/custom-permissions path, it returns information about custom permission configurations and their usage within the Grafana instance. This endpoint is typically used by administrators to audit and review customized access control settings, helping them understand how permissions have been tailored beyond the standard roles and ensure compliance with licensing terms and organizational security policies.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "licensing",
                "custom-permissions"
              ],
              "host": [
                "{{baseUrl}}"
