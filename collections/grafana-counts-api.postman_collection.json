          "name": "Grafana Get Folder Descendant Counts",
          "request": {
            "name": "Grafana Get Folder Descendant Counts",
            "description": {
              "content": "Returns statistical information about the descendants of a specified folder in Grafana, identified by its unique folder UID. This endpoint retrieves count data for various types of resources that exist within the folder hierarchy, such as dashboards, alerts, and other nested folders, providing administrators and users with a quick overview of the folder's contents without needing to traverse the entire folder structure manually.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "folders",
                ":folder_uid",
                "counts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
