          "id": "84fc45f3-519b-4bba-b00d-d41a15adb169",
          "name": "Grafana Clear Help Flags",
          "request": {
            "name": "Grafana Clear Help Flags",
            "description": {
              "content": "This API operation clears help flags for the currently authenticated user in Grafana by sending a GET request to the /user/helpflags/clear endpoint. Help flags are typically used to track which help tooltips, tutorials, or onboarding messages a user has already seen within the Grafana interface. By clearing these flags, the system resets the help state, causing previously dismissed help messages and guidance prompts to be displayed again as if the user were accessing those features for the first time. This can be useful for users who want to review onboarding materials or for administrators testing the user experience.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user",
                "helpflags",
                "clear"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
