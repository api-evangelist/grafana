          "name": "Grafana Get Home Dashboard",
          "request": {
            "name": "Grafana Get Home Dashboard",
            "description": {
              "content": "The Grafana Get Home Dashboard API operation retrieves the dashboard that is configured as the home dashboard for the current user or organization. When a GET request is made to the /dashboards/home endpoint, it returns the dashboard data that should be displayed when a user first logs into Grafana or navigates to the home page. This endpoint is useful for applications that need to programmatically access the default landing dashboard, whether it's a custom dashboard set by an administrator or the default Grafana home dashboard. The response includes the dashboard JSON model along with metadata such as the dashboard's unique identifier, title, and other configuration settings.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dashboards",
                "home"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
