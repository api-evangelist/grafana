                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dashboard\": {},\n  \"folderId\": \"<integer>\",\n  \"folderUid\": \"<string>\",\n  \"inputs\": [\n    {\n      \"name\": \"<string>\",\n      \"pluginId\": \"<string>\",\n      \"type\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"pluginId\": \"<string>\",\n      \"type\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"overwrite\": \"<boolean>\",\n  \"path\": \"<string>\",\n  \"pluginId\": \"<string>\"\n}",
