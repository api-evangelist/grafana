            {
              "name": "Grafana Delete Recording Rule Write Target",
              "id": "f7e97e8c-4753-4bc4-87a0-b12b25e521fd",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "DELETE",
                "header": [
