                                  "host": [
                                    "{{baseUrl}}"
                                  ],
                                  "path": [
                                    "cloudmigration",
                                    "migration",
                                    ":uid",
                                    "snapshot",
                                    ":snapshotUid",
                                    "cancel"
                                  ],
                                  "variable": [
                                    {
                                      "id": "74a782af-a571-4d49-9ab3-a4022c22d465",
                                      "key": "uid",
                                      "value": "<string>",
                                      "description": "(Required) Session UID of a session"
                                    },
                                    {
                                      "id": "cff5e8c0-485f-4fe6-81de-6b4963cafffa",
                                      "key": "snapshotUid",
                                      "value": "<string>",
                                      "description": "(Required) UID of a snapshot"
                                    }
                                  ]
                                },
                                "description": "This API operation cancels an in-progress snapshot within a specific cloud migration in Grafana. It uses a POST request to the endpoint '/cloudmigration/migration/{uid}/snapshot/{snapshotUid}/cancel', where {uid} represents the unique identifier of the migration and {snapshotUid} represents the unique identifier of the snapshot to be cancelled. When invoked, this operation terminates the snapshot process for the specified migration, allowing users to stop an ongoing snapshot creation or transfer that may be taking too long, consuming excessive resources, or is no longer needed."
                              },
