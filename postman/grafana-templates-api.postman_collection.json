        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "instance",
      "value": "your-instance"
    },
    {
      "key": "baseUrl",
      "value": "https://{{instance}}.grafana.net/api"
    }
  ]
}